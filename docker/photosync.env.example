# Copy this file to /opt/photosync/.env on the server and chmod it to 600.
# Never commit the real file.

UPLOAD_LOCATION=/opt/photosync/data/library
DB_DATA_LOCATION=/opt/photosync/data/postgres
IMMICH_HTTP_PORT=2283
IMMICH_ML_VERSION=v3.0.3
TZ=Asia/Shanghai
# Defaults to Simplified Chinese; set to en for English location names.
IMMICH_REVERSE_GEOCODING_LANGUAGE=zh-CN

# Generate a long random A-Za-z0-9 value. Do not reuse an account password.
DB_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# Optional Immich settings can be added according to the upstream documentation.
